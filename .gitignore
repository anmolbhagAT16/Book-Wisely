# Python virtual environments

.venv/
venv/
env/
ENV/


# Python cache files


__pycache__/
*.py[cod]
*$py.class


# Jupyter Notebook temporary files


.ipynb_checkpoints/


# Large local datasets


# Original raw dataset
Data/raw/

# 10% sample dataset (kept locally)
Data/interim/

# Cleaned modeling dataset (can be regenerated)
Data/processed/modeling_data_clean.parquet
Data/processed/route_stops.parquet

# Keep route lookup data because the application needs it
# Data/processed/route_stops.parquet must remain tracked


# Model files


# Ignore other saved models
Models/*.joblib

# Keep the model bundle required by the application
!Models/bookwisely_all_models.joblib


# Environment and secret files

.env
.env.*
!.env.example


# Logs and temporary files

*.log
*.tmp


# Operating system files

.DS_Store
Thumbs.db
desktop.ini


# Editor and testing files

.vscode/
.pytest_cache/
.mypy_cache/
.ruff_cache/
